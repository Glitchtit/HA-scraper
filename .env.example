# grocy_scraper environment configuration
# Copy this file to .env and fill in your values.

# ── k-ruoka.fi store ──────────────────────────────────────────────────────────
# The store ID appears in the k-ruoka.fi URL after you select a store, e.g.
# https://www.k-ruoka.fi/kauppa?storeId=N110
# Common stores: N110 = K-Supermarket Helsinki, N137 = K-Citymarket Tammisto
KRUOKA_STORE_ID=N110

# ── Grocy instance ────────────────────────────────────────────────────────────
# Base URL of your Grocy instance (no trailing slash).
GROCY_BASE_URL=https://grocy.example.com

# API key created in Grocy → user settings → Manage API keys.
GROCY_API_KEY=your_api_key_here

# ── Cloudflare bypass (kr-api fallback backend only) ─────────────────────────
# These settings are only needed if you use --no-graphql (use_graphql=False).
# The default GraphQL backend (mobile.k-ruoka.fi/graphql) does NOT need any
# Cloudflare bypass.

# Option A – FlareSolverr (recommended, free Docker service):
#   docker run -d -p 8191:8191 ghcr.io/flaresolverr/flaresolverr:latest
# FLARESOLVERR_URL=http://localhost:8191/v1

# Option B – Manual cookie injection (from your browser's DevTools after
#   visiting https://www.k-ruoka.fi/kauppa):
# CF_CLEARANCE=<value of the cf_clearance cookie>
# CF_USER_AGENT=<User-Agent your browser used>

# ── Advanced kr-api tuning (kr-api fallback backend only) ────────────────────
# These headers are checked by the k-ruoka.fi server. Update when the API
# rejects requests with HTTP 400 (inspect Network tab in DevTools for current values).
# K_BUILD_NUMBER=29159
# K_EXPERIMENTS=ab4d.10001.0!d2ae.10003.0!a.00145.0!a.00150.0!a.00154.1

# curl_cffi browser profile for TLS fingerprint impersonation (kr-api only).
# See https://curl-cffi.readthedocs.io/en/latest/impersonate.html for valid values.
# CURL_CFFI_IMPERSONATE=chrome124

# ── Barcode Buddy (for --discover) ───────────────────────────────────────────
# Base URL of your Barcode Buddy instance (no trailing slash).
# BARCODEBDY_URL=https://bbuddy.example.com

# API key generated in Barcode Buddy → menu → API.
# BARCODEBDY_API=your_bbuddy_api_key_here
