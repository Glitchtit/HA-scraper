# grocy_scraper environment configuration
# Copy this file to .env and fill in your values.

# ── k-ruoka.fi store ──────────────────────────────────────────────────────────
# The store ID can be found in the URL when you select a store on k-ruoka.fi,
# e.g. https://www.k-ruoka.fi/kauppa?storeId=P048
KRUOKA_STORE_ID=P048

# ── Grocy instance ────────────────────────────────────────────────────────────
# Base URL of your Grocy instance (no trailing slash).
GROCY_BASE_URL=https://grocy.example.com

# API key created in Grocy → Manage API keys (user settings).
GROCY_API_KEY=your_api_key_here
